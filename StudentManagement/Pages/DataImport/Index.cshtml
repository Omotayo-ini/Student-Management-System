@page
@model StudentManagement.Pages.DataImport.IndexModel
@{
    ViewData["Title"] = "Bulk Import Students";
}

<div class="container-fluid py-4">
    <h4 class="fw-bold mb-4">Bulk Import Students</h4>
    <p class="text-muted">Upload an Excel file to import multiple students at once.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
    }

    <!-- Step 1: Upload File -->
    @if (Model.ColumnMappings.Count == 0 && Model.ImportResult == null)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">Step 1: Upload Excel File</h5>
                <p class="text-muted small">Expected columns: First Name, Surname, Birthdate (YYYY/MM/DD), Phone Number, Email Address, Grade, Class Teacher</p>

                <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Select Excel File (.xlsx)</label>
                        <input type="file" class="form-control" asp-for="UploadFile" accept=".xlsx,.xls,.csv" required />
                        <div class="form-text">Maximum file size: 10MB</div>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-upload me-2"></i>Upload & Analyze
                    </button>
                    <a asp-page="/StudentRecords/Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                </form>
            </div>
        </div>
    }

    <!-- Step 2: Review Mappings -->
    @if (Model.ColumnMappings.Count > 0 && Model.ImportResult == null)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Step 2: Review Column Mappings</h5>
                <p class="text-muted small">Verify that the columns are mapped correctly before importing.</p>

                <form method="post" asp-page-handler="Import">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Excel Column</th>
                                <th>Mapped To</th>
                                <th>Required</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.ColumnMappings.Count; i++)
                            {
                                <tr>
                                    <td>@Model.ColumnMappings[i].SourceColumn</td>
                                    <td>
                                        <input type="hidden" name="mappings[@i].SourceColumn" value="@Model.ColumnMappings[i].SourceColumn" />
                                        <input type="hidden" name="mappings[@i].TargetField" value="@Model.ColumnMappings[i].TargetField" />
                                        <input type="hidden" name="mappings[@i].IsRequired" value="@Model.ColumnMappings[i].IsRequired.ToString().ToLower()" />
                                        <span class="badge bg-primary">@Model.ColumnMappings[i].TargetField</span>
                                    </td>
                                    <td>
                                        @if (Model.ColumnMappings[i].IsRequired)
                                        {
                                            <span class="badge bg-danger">Required</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Optional</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-database-add me-2"></i>Import Students
                        </button>
                        <a asp-page="/DataImport/Index" class="btn btn-outline-secondary">Start Over</a>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Step 3: Results -->
    @if (Model.ImportResult != null)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Import Results</h5>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h3 class="text-primary mb-0">@Model.ImportResult.TotalRows</h3>
                                <small class="text-muted">Total Rows</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body text-center">
                                <h3 class="mb-0">@Model.ImportResult.SuccessCount</h3>
                                <small>Successful</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-danger text-white">
                            <div class="card-body text-center">
                                <h3 class="mb-0">@Model.ImportResult.FailedCount</h3>
                                <small>Failed</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-info text-white">
                            <div class="card-body text-center">
                                <h3 class="mb-0">@Model.ImportResult.SuccessRate.ToString("F1")%</h3>
                                <small>Success Rate</small>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.ImportResult.Errors.Count > 0)
                {
                    <h6 class="text-danger">Errors:</h6>
                    <div class="alert alert-danger" style="max-height: 300px; overflow-y: auto;">
                        <ul class="mb-0 small">
                            @foreach (var error in Model.ImportResult.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                @if (Model.ImportResult.ImportedStudents.Count > 0)
                {
                    <h6 class="mt-4">Imported Students:</h6>
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Student ID</th>
                                    <th>Name</th>
                                    <th>Grade</th>
                                    <th>Age</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.ImportResult.ImportedStudents)
                                {
                                    <tr>
                                        <td>@student.StudentId</td>
                                        <td>@student.FullName</td>
                                        <td>@student.Grade</td>
                                        <td>@student.Age</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="d-flex gap-2 mt-3">
                    <a asp-page="/StudentRecords/Index" class="btn btn-primary">
                        <i class="bi bi-people me-2"></i>View Student Records
                    </a>
                    <a asp-page="/DataImport/Index" class="btn btn-outline-secondary">Import Another File</a>
                </div>
            </div>
        </div>
    }
</div>
