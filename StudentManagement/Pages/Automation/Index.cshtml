@page
@model StudentManagement.Pages.Automation.IndexModel
@{
    ViewData["Title"] = "Automation Dashboard";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h4 class="fw-bold">Automation Dashboard</h4>
        <p class="text-muted">Manage automated processes for the school year</p>
    </div>

    <div class="row g-4">
        <!-- Grade Rollover Card -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <i class="bi bi-arrow-up-circle text-primary fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Grade Rollover</h5>
                            <small class="text-muted">Advance students to next grade</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Auto-rollover enabled</span>
                            <span class="fw-bold">@Model.AutoRolloverEnabled / @Model.TotalStudents</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @(Model.TotalStudents > 0 ? (Model.AutoRolloverEnabled * 100 / Model.TotalStudents) : 0)%"></div>
                        </div>
                    </div>

                    @if (Model.IsRolloverDay)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-calendar-check me-2"></i>
                            Today is August 1st — automatic rollover will run.
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <a asp-page="Rollover" class="btn btn-primary">
                            <i class="bi bi-play-circle me-2"></i>Run Rollover
                        </a>
                        <a asp-page="Rollover" asp-route-preview="true" class="btn btn-outline-primary">
                            <i class="bi bi-eye me-2"></i>Preview
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Class List Upload Card -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <i class="bi bi-file-earmark-spreadsheet text-success fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Class List Upload</h5>
                            <small class="text-muted">Override grades & teachers</small>
                        </div>
                    </div>

                    <p class="text-muted">
                        Upload class lists from teachers to correct auto-assigned grades and assign class teachers.
                        This handles cases where students need to be in a different class variant (e.g., 3C instead of 3A).
                    </p>

                    <a asp-page="/ClassLists/Upload" class="btn btn-success">
                        <i class="bi bi-upload me-2"></i>Upload Class List
                    </a>
                </div>
            </div>
        </div>

        <!-- Age Update Card -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <i class="bi bi-calendar-event text-warning fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Age Updates</h5>
                            <small class="text-muted">Auto-calculate student ages</small>
                        </div>
                    </div>
                    <p class="text-muted mb-0">Ages are automatically updated based on birth dates. Toggle per-student in Student Records.</p>
                </div>
            </div>
        </div>

        <!-- Current Status -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <i class="bi bi-info-circle text-info fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Current Status</h5>
                            <small class="text-muted">@DateTime.Now.ToString("MMMM dd, yyyy")</small>
                        </div>
                    </div>
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="fs-3 fw-bold text-primary">@Model.CurrentTerm</div>
                            <small class="text-muted">Current Term</small>
                        </div>
                        <div class="col-6">
                            <div class="fs-3 fw-bold text-success">@Model.TotalStudents</div>
                            <small class="text-muted">Active Students</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>