@page
@model StudentManagement.Pages.Prospectus.IndexModel
@{
    ViewData["Title"] = "Prospectus Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold">Prospectus Management</h4>
            <p class="text-muted">Upload and manage school prospectus PDFs for automatic fee extraction.</p>
        </div>
    </div>

    <!-- Upload Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h6 class="fw-bold mb-0">Upload New Prospectus</h6>
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data" asp-page-handler="Upload">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Academic Year</label>
                        <select name="AcademicYear" class="form-select" required>
                            <option value="">Select Year...</option>
                            @for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 2; year--)
                            {
                            <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">PDF File</label>
                        <input type="file" name="PdfFile" class="form-control" accept=".pdf" required />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-upload me-2"></i>Upload
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Uploaded Prospectuses -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <h6 class="fw-bold mb-0">Uploaded Prospectuses</h6>
        </div>
        <div class="card-body">
            @if (Model.Prospectuses.Any())
            {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ACADEMIC YEAR</th>
                            <th>FILE NAME</th>
                            <th>UPLOADED</th>
                            <th>EXTRACTED RULES</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Prospectuses)
                            {
                        <tr>
                            <td>@item.AcademicYear</td>
                            <td>@item.FileName</td>
                            <td>@item.UploadedAt.ToDateTime().ToString("MMM dd, yyyy")</td>
                            <td>@item.ExtractedRules.Count rules</td>
                            <td>
                                <form method="post" asp-page-handler="Apply" asp-route-id="@item.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-check me-1"></i>Apply to Fees
                                    </button>
                                </form>
                                <a href="@item.FileUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                            }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-file-earmark-pdf fs-1 mb-3"></i>
                <p>No prospectuses uploaded yet.</p>
            </div>
            }
        </div>
    </div>
</div>