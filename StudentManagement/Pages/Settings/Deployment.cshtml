@page
@model StudentManagement.Pages.Settings.DeploymentModel
@{
    ViewData["Title"] = "Deployment Settings";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold">Deployment Settings</h4>
        <span class="badge bg-success bg-opacity-10 text-success">
            <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>Connected
        </span>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h6 class="fw-bold mb-3">Server Configuration</h6>
            <p class="text-muted mb-4">Select the hosting environment for your local deployment.</p>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card border-2 border-primary h-100">
                        <div class="card-body">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="serverType" id="iis" checked>
                                <label class="form-check-label fw-bold" for="iis">Run on Local IIS</label>
                            </div>
                            <p class="text-muted small mt-2 mb-0">
                                Standard deployment using Internet Information Services.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-2 border-light h-100">
                        <div class="card-body">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="serverType" id="kestrel">
                                <label class="form-check-label fw-bold" for="kestrel">Run on Kestrel (Localhost)</label>
                            </div>
                            <p class="text-muted small mt-2 mb-0">
                                Cross-platform web server for ASP.NET Core.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h6 class="fw-bold mb-3">Backup Strategy</h6>
            <div class="d-flex justify-content-between align-items-center">
                <p class="text-muted mb-0">Export current state to a portable JSON backup file.</p>
                <button class="btn btn-primary">
                    <i class="bi bi-download me-2"></i>Export to Local Backup
                </button>
            </div>
        </div>
    </div>
</div>