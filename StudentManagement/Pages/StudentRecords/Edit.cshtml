@page "{id}"
@model StudentManagement.Pages.StudentRecords.EditModel
@{
    ViewData["Title"] = "Edit Student";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-page="Index" class="text-decoration-none text-muted">Student Records</a></li>
                <li class="breadcrumb-item active">Edit Student</li>
            </ol>
        </nav>
        <h4 class="fw-bold">Edit Student</h4>
        <p class="text-muted">Update student information for <strong>@Model.Student.FullName</strong></p>
    </div>

    <form method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="Student.Id" />
        <input type="hidden" asp-for="Student.StudentId" />
        <input type="hidden" asp-for="Student.CreatedAt" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <!-- Personal Info -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h6 class="fw-bold mb-0"><i class="bi bi-person me-2"></i>Personal Info</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Student.FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                        <input asp-for="Student.FirstName" class="form-control" />
                        <span asp-validation-for="Student.FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Student.LastName" class="form-label">Surname <span class="text-danger">*</span></label>
                        <input asp-for="Student.LastName" class="form-control" />
                        <span asp-validation-for="Student.LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BirthDateInput" class="form-label">Birthdate</label>
                        <input asp-for="BirthDateInput" type="date" class="form-control"
                               onchange="calculateAge(this.value)" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Student.Age" class="form-label">Age (Calculated)</label>
                        <input asp-for="Student.Age" class="form-control bg-light" readonly id="ageDisplay" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Info -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h6 class="fw-bold mb-0"><i class="bi bi-telephone me-2"></i>Contact Info</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Student.ContactPhone" class="form-label">Phone Number</label>
                        <input asp-for="Student.ContactPhone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Student.ContactEmail" class="form-label">Email Address</label>
                        <input asp-for="Student.ContactEmail" type="email" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <!-- School Info -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h6 class="fw-bold mb-0"><i class="bi bi-mortarboard me-2"></i>School Info</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Student.Grade" class="form-label">Grade</label>
                        <select asp-for="Student.Grade" class="form-select" id="gradeSelect">
                            @{
                                var grades = ViewData["AvailableGrades"] as List<string> ?? new List<string>();
                                foreach (var g in grades)
                                {
                                    <option value="@g" selected="@(Model.Student.Grade == g ? "selected" : null)">@g</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Student.ClassTeacherId" class="form-label">Class Teacher</label>
                        <select asp-for="Student.ClassTeacherId" class="form-select"
                                asp-items="Model.TeacherSelectList">
                            <option value="">Assign Teacher</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Student.Status" class="form-label">Status</label>
                        <select asp-for="Student.Status" class="form-select">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                            <option value="graduated">Graduated</option>
                            <option value="repeating">Repeating</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <a asp-page="Details" asp-route-id="@Model.Student.Id" class="btn btn-outline-info">
                <i class="bi bi-eye me-2"></i>View Details
            </a>
            <div class="d-flex gap-3">
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-2"></i>Save Changes
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calculateAge(birthDate) {
            if (!birthDate) return;
            const today = new Date();
            const birth = new Date(birthDate);
            let age = today.getFullYear() - birth.getFullYear();
            const monthDiff = today.getMonth() - birth.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) {
                age--;
            }
            document.getElementById('ageDisplay').value = age;
        }

        function populateGrades() {
            const gradeSelect = document.getElementById('gradeSelect');
            // server already populated grade options; keep selection logic
            // if GradeLevel is used to filter, we can optionally auto-select first matching grade
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            // No JS-driven population required; server provides available grades.
        });
    </script>
}
