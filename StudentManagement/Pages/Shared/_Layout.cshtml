<!-- Pages/Shared/_Layout.cshtml -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduManager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/particle-sphere.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/voice-assistant.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-2 d-none d-md-block sidebar bg-white border-end">
                <div class="sidebar-sticky pt-3">
                    <div class="d-flex align-items-center mb-4 px-3">
                        <div class="bg-primary text-white rounded p-2 me-2">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">EduManager</h6>
                            <small class="text-muted">School Admin System</small>
                        </div>
                    </div>

                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Index" ? "active" : "")"
                               asp-page="/Index">
                                <i class="bi bi-grid-3x3-gap me-2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("Student") == true ? "active" : "")"
                               asp-page="/StudentRecords/Index">
                                <i class="bi bi-people me-2"></i> Student Records
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("Automation") == true ? "active" : "")"
                               asp-page="/Automation/AgeVerification">
                                <i class="bi bi-gear me-2"></i> Automation
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("Fee") == true ? "active" : "")"
                               asp-page="/FeeManagement/FeeStructure">
                                <i class="bi bi-cash-stack me-2"></i> Fee Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("DataImport") == true ? "active" : "")"
                               asp-page="/DataImport/Index">
                                <i class="bi bi-upload me-2"></i> Data Import
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("Analytics") == true ? "active" : "")"
                               asp-page="/Analytics/Index">
                                <i class="bi bi-graph-up me-2"></i> Analytics
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Prospectus/Index">
                                <i class="bi bi-file-earmark-pdf me-2"></i> Prospectus
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("Grades") == true ? "active" : "")"
                               asp-page="/Grades/Index">
                                <i class="bi bi-bookmark-star me-2"></i> Grades
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("Teachers") == true ? "active" : "")"
                               asp-page="/Teachers/Index">
                                <i class="bi bi-person-badge me-2"></i> Teachers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Payments/Record">
                                <i class="bi bi-cash-coin me-2"></i> Record Payment
                            </a>
                        </li>
                        <li class="nav-item mt-3">
                            <small class="text-muted px-3 text-uppercase" style="font-size: 0.7rem;">System</small>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("Settings") == true ? "active" : "")"
                               asp-page="/Settings/Deployment">
                                <i class="bi bi-gear me-2"></i> Settings
                            </a>
                        </li>
                    </ul>

                    <!-- User Profile -->
                    <div class="mt-auto p-3 border-top">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 32px; height: 32px;">
                                <small>JD</small>
                            </div>
                            <div class="ms-2">
                                <small class="d-block fw-bold">Jane Doe</small>
                                <small class="text-muted">Admin Account</small>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-10 ms-sm-auto px-md-4 bg-light min-vh-100">
                @RenderBody()
            </main>
        </div>
    </div>

    <aside id="voice-assistant" class="voice-assistant" aria-label="Voice assistant">
        <button id="voice-assistant-toggle" class="voice-assistant-toggle" type="button" aria-expanded="false" aria-controls="voice-assistant-panel" title="Open voice assistant">
            <i class="bi bi-mic-fill" aria-hidden="true"></i>
            <span class="visually-hidden">Open voice assistant</span>
        </button>
        <div id="voice-assistant-panel" class="voice-assistant-panel" hidden>
            <div class="voice-assistant-header">
                <div>
                    <strong>EduManager Assistant</strong>
                    <span id="voice-assistant-state" class="voice-assistant-state">Ready</span>
                </div>
                <button id="voice-assistant-close" class="btn-close" type="button" aria-label="Close voice assistant"></button>
            </div>
            <canvas id="voice-assistant-visualizer" class="voice-assistant-visualizer" aria-hidden="true"></canvas>
            <p id="voice-assistant-message" class="voice-assistant-message" role="status">Tap the microphone and speak a command.</p>
            <textarea id="voice-assistant-transcript" class="voice-assistant-transcript" rows="3" placeholder="Your transcript will appear here..."></textarea>
            <div class="voice-assistant-actions">
                <button id="voice-assistant-record" class="btn btn-primary" type="button">
                    <i class="bi bi-mic-fill me-1" aria-hidden="true"></i>Start listening
                </button>
                <button id="voice-assistant-send" class="btn btn-outline-primary" type="button">Send</button>
            </div>
            <div id="voice-assistant-confirmation" class="voice-assistant-confirmation" hidden>
                <p id="voice-assistant-confirmation-text"></p>
                <div class="voice-assistant-actions">
                    <button id="voice-assistant-confirm" class="btn btn-success" type="button">Confirm</button>
                    <button id="voice-assistant-cancel" class="btn btn-outline-secondary" type="button">Cancel</button>
                </div>
            </div>
        </div>
    </aside>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="~/js/voice-assistant.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>